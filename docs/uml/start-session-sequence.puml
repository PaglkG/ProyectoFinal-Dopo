@startuml
title Crear sesión (flujo implementado)
actor Cliente
participant "game: Game" as G
participant "session: GameSession" as S
participant "participant: Player" as P
participant "type: TypeOfMatch" as T
participant "sessions: List<GameSession>" as L
participant "playerStats: Map<Integer, Stats>" as M

Cliente -> G: startSession(parametersRules, parametersPowers, typeGame, typeMatche, player)
activate G
G -> S: getInstance(typeGame, player, typeMatche, parametersRules, parametersPowers)
alt no existe sesión
  S -> S: construir primera subclase concreta por reflexión
else ya existe sesión
  S -> S: reutilizar instancia guardada
end
note right of S
  PlayerVsPlayer recibe dos clases Power:
  jugador derecho, luego jugador izquierdo.
  PlayerVsBot recibe jugador derecho, bot izquierdo
  y perfil Clumsy/Offensive/Defensive/Expert.
  Las clases de poder son BlueAura, Lightning, Tornado e Illusion.
end note
S -> S: inicializar listas de participantes
S -> S: createMatchRule(typeMatche, parametersRules)
S -> T ++: constructor(List<String>) reflectivo
T --> S --: instancia concreta
S -> S: crear SoccerField y fijar timeLeft = 0
S --> G: instancia única de sesión
G -> S: getParticipantsLeft() / getParticipantsRight()
loop cada participante Player
  G -> P: getUserId()
  G -> M: computeIfAbsent(userId, estadísticas iniciales)
  M --> G: estadísticas del usuario
  G -> P: setStats(estadísticas guardadas)
end
opt la sesión aún no está registrada
  G -> L: add(session)
end
G --> Cliente: session
deactivate G
@enduml
