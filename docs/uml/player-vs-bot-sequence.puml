@startuml
title Inicializar sesión jugador contra bot
actor Cliente
participant "session: PlayerVsBot" as S
participant "GameSession" as Base
participant "human: Player" as P
participant "bot: BotPlayer" as B
participant "humanPower: Power" as WP
participant "botPower: Power" as WB

Cliente -> S ++: new PlayerVsBot(player, typeMatche, parametersRules, parametersPowers)
S -> Base ++: super(player, typeMatche, parametersRules)
Base -> Base: crear listas y cancha; instanciar modalidad reflectivamente
Base --> S --: inicialización base
alt player == true
  S -> P ++: new Player(1)
else player == false
  S -> P ++: new Player(2)
end
S -> WP ++: PowerFactory.create(parametersPowers[0])
S -> P: setSpecialPower(WP)
S -> S: resolver perfil parametersPowers[2]
S -> B ++: crearBotReflectivo(nombreCompletoPerfil)
S -> WB ++: PowerFactory.create(parametersPowers[1])
S -> B: setSpecialPower(WB)
S -> S: participantsLeft.add(human)
S -> S: participantsRight.add(bot)
S -> S: positionParticipants()
S --> Cliente --: sesión lista
note over S,B
  El humano queda a la izquierda y el bot a la derecha,
  según la regla confirmada. parametersPowers contiene
  poder del humano, poder del bot y perfil del bot, en ese orden.
end note
@enduml
