@startuml
title Modelo de clases del dominio (código actual)
skinparam packageStyle rectangle
hide empty members

package "domain" {
  class Game {
    - sessions: List<GameSession>
    - playerStats: Map<Integer, Stats>
    + startSession(parametersRules: List<String>, parametersPowers: List<String>, typeGame: String, typeMatche: String, player: boolean): GameSession
    + startSessionForView(parametersRules: List<String>, parametersPowers: List<String>, typeGame: String, typeMatche: String, player: boolean): int
    + closeSession(closeSession: GameSession): void
    + movePlayer(session: GameSession, player: SessionParticipant, direction: boolean): void
    + movePlayer(sessionIndex: int, participantId: String, direction: boolean): void
    + kickPlayer(sessionIndex: int, participantId: String): boolean
    + inspectSession(sessionIndex: int): SessionView
    + setParticipantPosition(sessionIndex: int, participantId: String, x: double, y: double): void
    + setBallPosition(sessionIndex: int, ballIndex: int, x: double, y: double): void
    + applyBallImpulse(sessionIndex: int, ballIndex: int, deltaX: double, deltaY: double): void
    + updateGame(sessionIndex: int): void
    + updateGame(game: GameSession): void
    + ImproveStatistics(session: GameSession, player: boolean, stats: String): void
    + save(): void
    + open(file: File): void
  }
  class "Game.SessionView" as SessionView <<record>> {
    + court: RectangleView
    + boundaries: List<RectangleView>
    + goals: List<RectangleView>
    + participants: List<ParticipantView>
    + balls: List<BallView>
    + goalsLeft: int
    + goalsRight: int
    + elapsedSeconds: double
    + finished: boolean
  }
  class "Game.ParticipantView" as ParticipantView <<record>> {
    + id: String
    + side: String
    + x: double
    + y: double
    + width: double
    + height: double
    + speed: int
  }
  class "Game.BallView" as BallView <<record>> {
    + index: int
    + x: double
    + y: double
    + radius: double
    + velocityX: double
    + velocityY: double
  }
  class "Game.RectangleView" as RectangleView <<record>> {
    + x: double
    + y: double
    + width: double
    + height: double
  }
  abstract class GameSession {
    - timeLeft: double
    - xBase: int
    - yBase: int
    - GRAVITY: double = 40 {static, readOnly}
    - TypeOfMatch: TypeOfMatch
    - allHitbox: Hitbox[]
    - field: SoccerField
    - goalsLeft: int
    - goalsRight: int
    - finished: boolean
    # participantsRight: List<SessionParticipant>
    # participantsLeft: List<SessionParticipant>
    + movePlayer(user: SessionParticipant, direction: boolean): void
    + kickPlayer(player: SessionParticipant): boolean
    + restartRound(): void
    + positionParticipants(): void
    + goal(side: String): void
    + checkTypeOfMatch(): void
    + updateGame(): void
    - collision(): void
    - closestOpponentInReach(attacker: RectangularHitbox, opponents: List<SessionParticipant>): SessionParticipant
    + getGoalsLeft(): int
    + getGoalsRight(): int
    + isFinished(): boolean
    + getElapsedSeconds(): double
    + getField(): SoccerField
    + getParticipantsLeft(): List<SessionParticipant>
    + getParticipantsRight(): List<SessionParticipant>
    + ImproveStatistics(player: boolean, stats: String): void
    - awardWinningPlayers(): void
  }
  class PlayerVsBot {
    + PlayerVsBot(player: boolean, typeMatche: String, parametersRules: List<String>, parametersPowers: List<String>)
    - createBot(difficulty: String): BotPlayer
  }
  class PlayerVsPlayer {
    + PlayerVsPlayer(player: boolean, typeMatche: String, parametersRules: List<String>, parametersPowers: List<String>)
  }
  abstract class SessionParticipant {
    - x: double
    - y: double
    - life: int = 100
    - maxLife: int = 100
    - UserHitbox: RectangularHitbox
    - stats: Stats
    - status: List<StatusEffect>
    - specialPower: Power
    + move(dir: boolean): void
    ~ moveBy(horizontalDistance: double): void
    + getStats(): Stats
    + setStats(stats: Stats): void
    + getLife(): int
    + getMaxLife(): int
    + blocksMovement(): boolean
    + takeDamage(damage: int): void
    + applyStatusEffect(effect: StatusEffect): void
    + updateStatusEffects(): void
    + jump(): void
    + power(): void
    + getSpecialPower(): Power
    + setSpecialPower(specialPower: Power): void
    + resetPosition(x: double, y: double): void
    + resizeHitbox(width: double, height: double): void
    + ImproveStatistics(stats: String): void
    + intersects(hitbox: Hitbox): HitboxContact
  }
  class Player {
    - user: int
    + getUserId(): int
  }
  class BotPlayer {
    + decideAction(field: SoccerField): Set<Action>
  }
  class Clumsy
  class Offensive
  class Defensive
  class Expert
  class SoccerField {
    - LeftGoalHitbox: RectangularHitbox
    - RightGoalHitbox: RectangularHitbox
    - fieldHitbox: RectangularHitbox[]
    - balls: Ball[]
    + advanceBalls(deltaSeconds: double, gravity: double): void
    + addBall(ball: Ball): void
    + resolveBallCollisions(restitution: double): void
    + resolveBallParticipantCollisions(participants: Iterable<SessionParticipant>, restitution: double, minimumLandingSpeed: double): void
    + resolveWalkingContact(moved: SessionParticipant, previousX: double, participants: Iterable<SessionParticipant>, restitution: double): void
    + keepBallInsideCourt(ball: Ball, retention: double): void
    - resolveBallPair(first: Ball, second: Ball, restitution: double): void
    - resolveBallParticipant(ball: Ball, participant: SessionParticipant, restitution: double, minimumLandingSpeed: double): void
    - validBallPosition(candidate: Ball, moved: SessionParticipant, participants: Iterable<SessionParticipant>): boolean
    + balls(): Ball[]
    + courtX(): double
    + courtY(): double
    + courtWidth(): double
    + courtHeight(): double
    + boundaryThickness(): double
    + groundY(): double
    + bounceBallAtWallsAndGoalFrames(ball: Ball, retention: double): void
    + bounceBallAtGround(ball: Ball, retention: double, minimumSpeed: double): void
    + resetBall(x: double, y: double): void
    + getHitboxField(): RectangularHitbox[]
    + getHitboxBalls(): CircularHitbox[]
    + hitboxs(): Hitbox[]
    + getBalls(): Ball[]
    + getGoalHitboxes(): RectangularHitbox[]
    + contactingPart(other: Hitbox): HitboxContact
    + intersects(hitbox: Hitbox): HitboxContact
    + goalSideFor(ball: Ball): String
    + isOutside(ball: Ball): boolean
    + isOutside(participant: SessionParticipant): boolean
    + touchesForbiddenBoundary(participant: SessionParticipant): boolean
    + touchesGround(ball: Ball): boolean
    + groundCenterY(ball: Ball): double
    + positionParticipants(left: SessionParticipant, right: SessionParticipant): void
  }
  class Ball {
    - physical: boolean
    - velocityX: double
    - velocityY: double
    - BallHitbox: CircularHitbox
    + resetBall(width: double, height: double): void
    + getHitbox(): CircularHitbox
    + getX(): double
    + getY(): double
    + getRadius(): double
    + getVelocityX(): double
    + getVelocityY(): double
    + applyImpulse(deltaX: double, deltaY: double): void
    + ensureHorizontalDirection(direction: int, minimumSpeed: double): void
    + advance(deltaSeconds: double, gravity: double): void
    + bounceAt(centerY: double, retention: double, minimumSpeed: double): void
    + bounceHorizontallyAt(centerX: double, retention: double): void
    + bounceVerticallyAt(centerY: double, retention: double): void
    + intersects(hitbox: Hitbox): HitboxContact
  }
  class Stats {
    + POINTS_PER_WIN: int = 5 {static, readOnly}
    + POINTS_PER_UPGRADE: int = 5 {static, readOnly}
    + KICK_BASE_DAMAGE: int = 10 {static, readOnly}
    + KICK_DAMAGE_PER_LEVEL: int = 5 {static, readOnly}
    - points: int = 0
    - action: Map<String, Integer>
    + getSpeed(): int
    + getKickDamage(): int
    + getPoints(): int
    + getStatistic(statistic: String): int
    + awardWin(): void
    + ImproveStatistics(stats: String): void
  }
  class StatusEffect {
    + STUNNED: String = "stunned" {static, readOnly}
    + STUN_DURATION_SECONDS: double = 3.0 {static, readOnly}
    - type: String
    - duration: double
    - remaining: double
    + StatusEffect(type: String, duration: double)
    + update(): void
    + isExpired(): boolean
    + refresh(): void
    + getType(): String
    + getDuration(): double
    + getRemaining(): double
    + getSpeedFactor(): double
    + getJumpFactor(): double
    + blocksMovement(): boolean
  }
  enum Action {
    LEFT
    RIGHT
    JUMP
    POWER
  }
  abstract class TypeOfMatch {
    + check(parameters: List<String>): boolean
  }
  class ByGoals {
    - goals: int
  }
  class ByTime {
    - minutes: int
    - suddenDeath: boolean
  }
  class GameException {
    + GameException(message: String)
    + GameException(message: String, cause: Throwable)
  }
  abstract class Power
  class AuraAzul
  class Rayo
  class Tornado
  class Ilusion
  class PowerFactory {
    + {static} create(className: String): Power
  }
  PowerFactory ..> Power
  Power <|-- AuraAzul
  Power <|-- Rayo
  Power <|-- Tornado
  Power <|-- Ilusion
}

package "domain.hitbox" {
  interface Hitbox {
    + intersects(hitbox: Hitbox): HitboxContact
    + reposition(x: double, y: double): void
  }
  class HitboxContact <<record>> {
    + name: String
    + hitbox: Hitbox
    + none(): HitboxContact {static}
    + isContact(): boolean
  }
  class HitboxIntersections <<utility>> {
    + intersects(first: Hitbox, second: Hitbox): HitboxContact {static}
  }
  class CircularHitbox {
    + intersects(hitbox: Hitbox): HitboxContact
    + reposition(x: double, y: double): void
  }
  class RectangularHitbox {
    + intersects(hitbox: Hitbox): HitboxContact
    + reposition(x: double, y: double): void
  }
}
package "presentation.controllers" {
  class GameController {
    - game: Game
    - session: GameSession
    + startGame(): void
    + movePlayer(participant: SessionParticipant, direction: char): void
    + jumpPlayer(participant: SessionParticipant): void
    + activatePower(participant: SessionParticipant): void
  }
}

package "presentation.testing" {
  class MechanicsTestApp {
    + main(args: String[]): void {static}
  }
  class MechanicsTestSetupPanel {
    - onStart: Consumer<MechanicsTestConfiguration>
    + MechanicsTestSetupPanel(onStart: Consumer<MechanicsTestConfiguration>)
  }
  class MechanicsTestConfiguration <<record>> {
    + sessionMode: SessionMode
    + matchMode: MatchMode
    + limit: int
    + sessionClass: String
    + matchClass: String
    + ruleParameters: List<String>
    + rightPowerClass: String
    + leftPowerClass: String
    + botProfile: String
    + playerOne: boolean
    + defaults(): MechanicsTestConfiguration {static}
  }
  class MechanicsTestPanel {
    - controller: MechanicsTestController
    + MechanicsTestPanel()
    + MechanicsTestPanel(configuration: MechanicsTestConfiguration)
    + stopSimulation(): void
  }
  class MechanicsTestController {
    - game: Game
    - activeSessionIndex: int
    - movement: PresentationMovement
    - configuration: MechanicsTestConfiguration
    + MechanicsTestController()
    + MechanicsTestController(configuration: MechanicsTestConfiguration)
    + startNewSession(sessionMode: SessionMode, matchMode: MatchMode, limit: int): void
    + restartConfiguredSession(): void
    + step(): void
    + setMovementControl(control: Control, pressed: boolean): void
    + kickLeft(): boolean
    + kickRight(): boolean
    + runScenario(scenario: Scenario): void
    + getSessionView(): Game.SessionView
  }
  enum Scenario {
    LEFT_GOAL
    RIGHT_GOAL
    PLAYER_BALL_CONTACT
    GROUND_BOUNCE
    SAFE_FIELD_CONTACT
    BALL_SIDE_REBOUND
    BALL_BALL_COLLISION
    KICK_OPPONENT
    PARTICIPANT_OUTSIDE
    PARTICIPANT_TOUCHES_SIDE
    PARTICIPANTS_OVERLAP
    SUDDEN_DEATH_WIN
  }
  enum MatchMode {
    GOALS
    TIME
  }
  enum SessionMode {
    PLAYER_VS_PLAYER
    PLAYER_VS_BOT
  }
  class PresentationMovement <<presentation-only>> {
    - held: EnumSet<Control>
    - jumpRequested: EnumSet<Control>
    - verticalSpeeds: Map<String, Double>
    - activeGame: Game
    - activeSessionIndex: int
    - JUMP_SPEED: double = 110
    - GRAVITY: double = 180
    + setControl(control: Control, pressed: boolean): void
    + clearInputs(): void
    + reset(game: Game, sessionIndex: int): void
    + resetAfterRound(game: Game, sessionIndex: int): void
    + update(game: Game, sessionIndex: int, mode: SessionMode): void
    - updateActor(game: Game, sessionIndex: int, actor: Game.ParticipantView, opponent: Game.ParticipantView, leftControl: Control, rightControl: Control, jumpControl: Control): void
    - supportedByBall(balls: List<Game.BallView>, x: double, y: double, width: double, height: double): boolean
    - resolveBallVerticalContact(balls: List<Game.BallView>, x: double, oldY: double, nextY: double, width: double, height: double, verticalSpeed: double): double
    - overlapsHorizontally(x: double, width: double, ball: Game.BallView): boolean
  }
  enum Control {
    LEFT_LEFT
    LEFT_RIGHT
    LEFT_JUMP
    RIGHT_LEFT
    RIGHT_RIGHT
    RIGHT_JUMP
  }
}

Game *-- SessionView
SessionView *-- RectangleView
SessionView *-- ParticipantView
SessionView *-- BallView

Game "1" *-- "0..*" GameSession : sessions
GameSession <|-- PlayerVsBot
GameSession <|-- PlayerVsPlayer
GameSession "1" *-- "1" SoccerField : field
GameSession "1" o-- "0..*" SessionParticipant : participants
GameSession --> TypeOfMatch
GameSession ..> GameException : errors
Stats ..> GameException : invalid upgrade
GameSession ..> Hitbox : allHitbox[]
SessionParticipant <|-- Player
SessionParticipant <|-- BotPlayer
BotPlayer <|-- Clumsy
BotPlayer <|-- Offensive
BotPlayer <|-- Defensive
BotPlayer <|-- Expert
SoccerField "1" *-- "1..*" Ball : balls
SoccerField "1" *-- "4" RectangularHitbox : fieldHitbox
SoccerField "1" *-- "2" RectangularHitbox : goal hitboxes
Ball "1" *-- "1" CircularHitbox : BallHitbox
SessionParticipant "1" *-- "1" RectangularHitbox : UserHitbox
SessionParticipant --> Stats
SessionParticipant --> "0..*" StatusEffect
SessionParticipant --> Power : specialPower
SessionParticipant ..> Action
Hitbox <|.. CircularHitbox
Hitbox <|.. RectangularHitbox
Hitbox <|.. Ball
Hitbox <|.. SoccerField
Hitbox <|.. SessionParticipant
HitboxContact --> Hitbox : hitbox
HitboxIntersections ..> HitboxContact
HitboxIntersections ..> Hitbox
HitboxIntersections ..> CircularHitbox
HitboxIntersections ..> RectangularHitbox
HitboxIntersections ..> Ball
HitboxIntersections ..> SessionParticipant
HitboxIntersections ..> SoccerField
CircularHitbox ..> HitboxIntersections
RectangularHitbox ..> HitboxIntersections
Ball ..> CircularHitbox : delegates intersection
SessionParticipant ..> RectangularHitbox : delegates intersection
SoccerField ..> HitboxIntersections : detects named contacts
TypeOfMatch <|-- ByGoals
TypeOfMatch <|-- ByTime
GameController --> Game
GameController --> GameSession
MechanicsTestApp ..> MechanicsTestPanel
MechanicsTestApp ..> MechanicsTestSetupPanel
MechanicsTestSetupPanel ..> MechanicsTestConfiguration
MechanicsTestPanel ..> MechanicsTestConfiguration
MechanicsTestPanel --> MechanicsTestController
MechanicsTestController --> Game
MechanicsTestController ..> Scenario
MechanicsTestController --> PresentationMovement
MechanicsTestPanel ..> Game : Game.SessionView
PresentationMovement --> Game
MechanicsTestPanel ..> Control

note bottom of Hitbox
  intersects() devuelve entidad y hitbox contactadas.
  Sin contacto: nombre vacío y hitbox nula.
  La geometría incluye contacto de bordes.
end note
note bottom of GameSession
  updateGame() usa paso fijo de 1/60 s.
  Coordina goles, errores de salida/superposición
  y colisiones entre balones y participantes.
  SoccerField avanza los balones y resuelve sus
  colisiones entre sí, con participantes y con
  límites, arcos y suelo. movePlayer()
  permite empujar el balón en pasos pequeños sin
  cambiar su velocidad ni atravesarlo.
  kickPlayer() valida participante y sesión,
  prioriza un rival en alcance para aplicar daño
  y, si no lo hay, impulsa el balón alcanzable.
end note
note right of SoccerField
  Contiene y recorre los balones, límites
  y zonas de gol; resuelve el contacto
  entre balones, con participantes y con
  la geometría de cancha.
end note
note bottom of Ball
  Guarda posición y velocidad, integra
  el movimiento y ejecuta rebotes e impulsos
  que le delegan la cancha o la sesión.
end note
@enduml
    + MechanicsTestController()
