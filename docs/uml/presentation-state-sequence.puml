@startuml
title Actualización del estado compartido de presentación

participant "Temporizador Swing" as Timer
participant DOPOSoccerGUI as GUI
participant Game
participant PresentationState as State
participant MatchPanel as Match
participant "Panel de destino" as Panel
participant MainMenuPanel as Menu
participant "PresentationOptions" as Options
participant GameCatalog as Catalog

GUI -> Game : getSessionTypes(), getBotTypes(), getMatchTypes() y getPowerTypes()
Game -> Catalog : descubrir subclases de GameSession y BotPlayer
Game -> Catalog : leer registros de reglas y poderes
Game --> GUI : listas de modalidades, bots, reglas y poderes
GUI -> State : publicar las cuatro listas
Panel -> State : consultar catálogos
State --> Panel : opciones de los selectores y poderes para filtrar personajes
Panel -> Options : leer rótulos, límites y perfiles de options.properties
Options --> Panel : metadatos de las opciones y sus recursos

loop Mientras se muestra la cancha
    Timer -> GUI : updateGame()
    GUI -> Game : updateGame()
    GUI -> Game : Consultar el estado del paso
    Game --> GUI : Datos del paso
    GUI -> State : setMatch(captura inmutable) [privado]
    GUI -> Match : refreshMatchView()
    Match -> State : getMatch()
    State --> Match : MatchSnapshot
    opt La partida terminó
        GUI -> GUI : showScreen(RESULTS)
    end
end

opt Mostrar Preparación, Resultados o Tienda
    GUI -> Panel : refreshFromState()
    Panel -> State : getMatch()
    State --> Panel : MatchSnapshot o vacío
end

opt Cargar una partida guardada desde el menú
    Menu -> GUI : openMatch(file)
    GUI -> GUI : leer configuración visual (.ui o archivo integrado)
    GUI -> Game : open(file)
    Game --> GUI : sesión restaurada
    GUI -> State : setMatch(captura restaurada)
    GUI -> GUI : showScreen(PAUSE)
end
@enduml
