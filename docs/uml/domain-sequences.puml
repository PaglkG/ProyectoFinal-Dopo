@startuml
title Game constructor (flujo implementado)
actor Usuario
participant "game: Game" as G
Usuario -> G ++: new Game()
  G -> G: session = null
G --> Usuario --: instancia Game
@enduml

@startuml
title closeSession (flujo implementado)
actor Usuario
participant "game: Game" as G
Usuario -> G ++: closeSession()
G -> G: session = null
G --> Usuario --: void
note over G
  Game limpia su referencia; GameSession conserva
  la instancia singleton para una llamada posterior.
end note
@enduml

@startuml
title movePlayer (flujo implementado)
actor Usuario
participant "game: Game" as G
participant "session: GameSession" as S
participant "player: SessionParticipant" as P
participant "field: SoccerField" as F
participant "collisions: CollisionFacade" as C
participant "geometry: CourtGeometry" as CG
participant "resolver: BallCollisionResolver" as BR
participant "participant resolver: BallParticipantCollisionResolver" as PR
participant "axis resolver: CollisionAxisResolver" as AR
participant "circle-rectangle resolver: CircleRectangleCollisionResolver" as CR
participant "ball: Ball" as B
Usuario -> G: movePlayer(player, direction)
G -> S: movePlayer(player, direction)
S -> P: move(direction)
P -> P: guardar posición X/Y anterior
S -> F: resolveWalkingContact(player, previousX, participants)
F -> C: resolveWalkingContact(player, previousX, participants)
loop balones que intersectan al participante
  alt empuje permitido (balón quieto o en movimiento)
    C -> BR: recorrer contacto de caminata
    BR -> CG: isValidBallPosition(...)
    CG --> BR: posición permitida
    BR -> B: reposicionar en pasos pequeños
    note over S,B: El empuje conserva la velocidad actual
  else el empuje choca con límite, balón o participante
    BR -> B: conservar la última posición válida
    BR -> P: restaurar posición horizontal anterior
  end
end
note over P,B
  Si el movimiento reduce el solapamiento horizontal con un balón ya en contacto,
  el jugador se aleja y el balón conserva su posición.
end note
alt direction == true
  note right of P: true = derecha
else direction == false
  note right of P: false = izquierda
end
note over G,P
  La sesión ignora solicitudes para participantes no registrados
  o después de finalizar el partido. El desplazamiento total
  equivale a 150 × speed / 60. Empuja balones quietos y en movimiento
  sin cambiar su velocidad y sin atravesar límites u otros objetos.
end note
@enduml

