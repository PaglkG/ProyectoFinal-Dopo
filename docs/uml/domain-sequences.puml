@startuml
title improveStatistics (implementación actual)
actor Usuario
participant "game: Game" as G
participant "session: GameSession" as S
participant "participante seleccionado" as P
participant "stats: Stats" as T
Usuario -> G: improveStatistics(player, stat)
G -> S: improveStatistics(player, stat)
alt player == true
  S -> P: improveStatistics(stat) [lado derecho / jugador 1]
else player == false
  S -> P: improveStatistics(stat) [lado izquierdo / jugador 2]
end
P -> T: improveStatistics(stat)
alt saldo >= 5 y habilidad válida
  T -> T: incrementar habilidad en 1
  T -> T: restar 5 puntos
else saldo insuficiente o habilidad desconocida
  T --> G: GameException
end
@enduml

@startuml
title kickPlayer contra rival (implementación actual)
actor Usuario
participant "game: Game" as G
participant "session: GameSession" as S
participant "attacker: SessionParticipant" as A
participant "target: SessionParticipant" as T
participant "attacker stats: Stats" as ST
participant "target status: StatusEffect" as E
Usuario -> G: kickPlayer(participantId)
G -> S: kickPlayer(attacker)
S -> A: blocksMovement()
alt sesión terminada, atacante inválido o aturdido
  S --> G: false
else atacante activo
  S -> S: buscar rival más cercano a <= 8 unidades
  alt rival al alcance
    S -> A: getStats()
    A -> ST: getKickDamage() [10 + 5 × (kick - 1)]
    S -> T: takeDamage(damage)
    alt vida llega a 0
      T -> T: clamp life a 0
      T -> E: new StatusEffect(STUNNED, 3 s)
      note over T,E
        No puede moverse ni patear.
        Al expirar el efecto recupera 100 de vida.
      end note
    else conserva vida positiva
      T -> T: restar daño
    end
    S --> G: true
  else ningún rival al alcance
    S -> S: probar alcance del balón
    S --> G: resultado del impulso al balón
  end
end
@enduml

@startuml
title resetSession (reinicio de ronda confirmado)
actor Usuario
participant "game: Game" as G
participant "session: GameSession" as S
participant "field: SoccerField" as F
participant "ball: Ball" as B
participant "participantes" as P
Usuario -> G: resetSession(session)
G -> S: restartRound()
S -> F: resetBall(centroX, centroY)
loop cada balón
  F -> B: ubicar centro y detener
end
S -> F: positionParticipants(left, right)
F -> P: resizeHitbox(width, height) para ambos
F -> P: reposition(x, y) para cada lado
F -> P: rememberCurrentPosition() para ambos
note over G,P
  Conserva marcador, modalidad, tiempo y estado de finalización.
  Reutiliza la instancia singleton, sin crear otra sesión.
end note
@enduml

@startuml
title updateGame y colisiones (implementación actual)
actor Reloj
participant "game: Game" as G
participant "session: GameSession" as S
participant "participantes / hitboxes" as P
participant "field: SoccerField" as F
participant "collisions: CollisionFacade" as C
participant "court geometry: CourtGeometry" as CG
participant "ball resolver: BallCollisionResolver" as BR
participant "participant resolver: BallParticipantCollisionResolver" as PR
participant "axis resolver: CollisionAxisResolver" as AR
participant "circle-rectangle resolver: CircleRectangleCollisionResolver" as CR
participant "ball: Ball" as B
Reloj -> G: updateGame()
G -> S: updateGame()
alt sesión ya terminada
  S --> G: no avanza
else sesión activa
  loop cada participante
    S -> P: updateStatusEffects()
    P -> P: StatusEffect.update() [1/60 s]
    opt aturdimiento expirado
      P -> P: restaurar vida máxima (100)
    end
  end
  S -> S: tiempo += 1/60 s
  S -> F: advanceBalls(1/60, 40)
  loop cada balón
    F -> B: advance(1/60, 40)
    B -> B: guardar centro anterior antes de integrar
  end
  S -> S: collision()
  S -> S: validar participantes fuera/límites y superposición
  opt participante fuera o toca límite superior/lateral
    S --> G: GameException("objeto fuera de la partida")
  end
  opt participantes superpuestos
    S --> G: GameException("dos objetos super puestos")
  end
  S -> S: goal()
  loop cada balón
    S -> F: goalSideFor(ball)
    alt centro dentro de un arco
      S -> S: sumar punto al lado opuesto
      S -> F: resetBall(centro)
      S -> S: reposicionar participantes simétricamente
      S -> S: checkTypeOfMatch()
    end
  end
  alt se anotó un gol
    S --> G: terminar procesamiento de colisiones
  else no hubo gol
    S -> F: resolveBallCollisions(70%)
    F -> C: resolveBallCollisions(70%)
    C -> BR: resolveAll(balls, 70%)
    loop pares de balones en contacto
      BR -> B: corregir penetración entre hitboxes circulares
      opt se aproximan sobre la normal
        BR -> B: intercambiar velocidades normales (masas iguales, e=0.70)
      end
    end
    S -> F: resolveBallParticipantCollisions(participants, 70%, 0.5)
    F -> C: resolveBallParticipantCollisions(...)
    C -> PR: resolveAll(balls, participants, 70%, 0.5)
    loop cada balón y participante en contacto
      PR -> CR: resolver contacto círculo-rectángulo exacto
      CR -> AR: clasificar eje con overlap AABB actual/anterior
      AR --> CR: eje horizontal o vertical
      CR -> B: corregir el círculo hasta tocar el rectángulo por ese eje
      opt el balón se aproxima al participante
        CR -> B: reflejar solo la componente normal (superficie fija, e=0.70)
      end
      opt participante desciende sobre el balón y su velocidad es menor a 0.5
        PR -> B: establecer velocidad vertical descendente mínima (0.5)
      end
    end
    loop cada balón
      S -> F: bounceBallAtWallsAndGoalFrames(ball, 70%)
      F -> C: bounceBallAtWallsAndGoalFrames(...)
      C -> CG: bounceBallAtWallsAndGoalFrames(...)
      CG -> CR: resolver contacto con paredes/arcos rectangulares
      CR -> AR: elegir eje con overlap actual/anterior
      AR --> CR: eje y lado del impacto
      CR -> B: separar círculo y reflejar componente normal
      note over CG,CR: La boca del arco se omite para que el balón pueda entrar y marcar.
      S -> F: keepBallInsideCourt(ball, 70%)
      F -> C: keepBallInsideCourt(...)
      C -> CG: keepBallInsideCourt(...)
      opt una colisión desplazó el balón más allá de un límite
        CG -> B: corregir al borde y reflejar velocidad si iba hacia fuera
      end
      note over S,CG: La geometría mantiene el balón dentro de la cancha.
    end
    S -> P: guardar posición actual como previa para el siguiente paso
    S -> S: checkTypeOfMatch()
    opt transición a partida terminada con marcador desigual
      S -> S: awardWinningPlayers()
      loop cada participante humano del lado ganador
        S -> P: Stats.awardWin() [sumar 5 puntos]
      end
    end
  end
end
@enduml
