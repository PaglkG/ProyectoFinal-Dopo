@startuml
title Game constructor (flujo implementado)
actor Usuario
participant "game: Game" as G
Usuario -> G ++: new Game()
G -> G: inicializar sessions
G --> Usuario --: instancia Game
@enduml

@startuml
title closeSession (flujo implementado)
actor Usuario
participant "game: Game" as G
participant "sessions: List<GameSession>" as L
Usuario -> G ++: closeSession(session)
G -> L: remove(session)
L --> G: sesión retirada
G --> Usuario --: void
note over G,L
  Game elimina de la lista la sesión recibida.
end note
@enduml

@startuml
title movePlayer (flujo implementado)
actor Usuario
participant "game: Game" as G
participant "session: GameSession" as S
participant "player: SessionParticipant" as P
participant "field: SoccerField" as F
participant "ball: Ball" as B
Usuario -> G: movePlayer(session, player, direction)
G -> S: movePlayer(player, direction)
S -> P: guardar posición horizontal anterior
S -> P: move(direction)
S -> F: resolveWalkingContact(player, previousX, participants, 0.70)
loop balones que intersectan al participante
  alt balón quieto y empuje permitido
    F -> B: reposicionar en pasos pequeños
    note over S,B: El empuje no cambia la velocidad
  else balón en movimiento
    F -> B: separar y reflejar velocidad normal
    F -> P: restaurar posición horizontal anterior
  else el empuje choca con límite, balón o participante
    F -> B: conservar la última posición válida
    F -> P: restaurar posición horizontal anterior
  end
end
alt direction == true
  note right of P: true = derecha
else direction == false
  note right of P: false = izquierda
end
note over G,P
  La sesión ignora solicitudes para participantes no registrados
  o después de finalizar el partido. El desplazamiento total
  equivale a 150 × speed / 60. Empuja balones quietos; ante un
  balón en movimiento, resuelve el rebote sin atravesarlo.
end note
@enduml

