@startuml
title Game constructor (flujo implementado)
actor Usuario
participant "game: Game" as G
Usuario -> G ++: new Game()
G -> G: inicializar sessions
G --> Usuario --: instancia Game
@enduml

@startuml
title closeSession (flujo implementado)
actor Usuario
participant "game: Game" as G
participant "sessions: List<GameSession>" as L
Usuario -> G ++: closeSession(session)
G -> L: remove(session)
L --> G: sesión retirada
G --> Usuario --: void
note over G,L
  Game elimina de la lista la sesión recibida.
end note
@enduml

@startuml
title movePlayer (flujo implementado)
actor Usuario
participant "game: Game" as G
participant "session: GameSession" as S
participant "player: SessionParticipant" as P
Usuario -> G: movePlayer(session, player, direction)
G -> S: movePlayer(player, direction)
S -> P: move(direction)
P -> P: get speed statistic
P -> P: reposition(x ± 150 × speed / 60, y)
alt direction == true
  note right of P: true = derecha
else direction == false
  note right of P: false = izquierda
end
note over G,P
  La sesión ignora solicitudes para participantes no registrados
  o después de finalizar el partido. El paso equivale a 1/60 s.
end note
@enduml

