@startuml
title Game constructor (flujo implementado)
actor Usuario
participant "game: Game" as G
Usuario -> G ++: new Game()
G -> G: inicializar sessions
G --> Usuario --: instancia Game
@enduml

@startuml
title closeSession (PDF: intención; código defectuoso)
actor Usuario
participant "game: Game" as G
participant "sessions: List<GameSession>" as L
Usuario -> G ++: closeSession(session)
G -> L: remove(session)
L --> G: sesión retirada
G --> Usuario --: void
note over G,L
  El PDF propone retirar la sesión solicitada.
  El código actual ejecuta remove(0) y puede cerrar otra sesión.
end note
@enduml

@startuml
title movePlayer (PDF: intención; código sin implementar)
actor Usuario
participant "game: Game" as G
participant "session: GameSession" as S
participant "player: SessionParticipant" as P
Usuario -> G: movePlayer(session, player, direction)
G -> S: movePlayer(player, direction)
S -> P: move(direction)
alt direction == true
  P -> P: moveRight()
else direction == false
  P -> P: moveLeft()
end
note over G,P
  En el PDF: true corresponde a derecha y false a izquierda.
  El movimiento y esa regla no están implementados en Java;
  la regla no aparece confirmada en logica-proyecto.md.
end note
@enduml

